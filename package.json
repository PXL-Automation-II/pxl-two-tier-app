{
  "name": "pxl-two-tier-app",
  "version": "1.0.0",
  "private": true,
  "description": "Two-Tier Node.js Express + MySQL demonstration application for PXL Automation II",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm run check",
    "check": "npm run lint && npm run format:check",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "node scripts/db-check.js",
    "ci": "npm run check && npm test"
  },
  "keywords": [
    "pxl",
    "automation2",
    "two-tier",
    "aws",
    "terraform",
    "express",
    "mysql"
  ],
  "author": "PXL Automation II Team",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/PXL-Automation-II/pxl-two-tier-app.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "prettier": "^3.9.9"
  }
}
